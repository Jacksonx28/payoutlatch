{
  "name": "payoutlatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:contract": "sh scripts/contract.sh test",
    "build:contract": "sh scripts/contract.sh build",
    "test:sandbox": "node scripts/sandbox.mjs",
    "build": "esbuild src/wallet.mjs --bundle --format=esm --platform=browser --inject:src/polyfill.mjs --define:global=globalThis --minify --outfile=dist/wallet.js --define:process.env.NODE_ENV='\"production\"'",
    "test:live": "node scripts/prove-testnet.mjs",
    "verify:approval": "node scripts/verify-approval.mjs"
  },
  "devDependencies": {
    "cargo-near": "0.23.0",
    "esbuild": "0.28.2",
    "near-workspaces": "5.0.0"
  },
  "dependencies": {
    "@near-wallet-selector/core": "10.1.4",
    "@near-wallet-selector/meteor-wallet": "10.1.4",
    "buffer": "6.0.3",
    "events": "3.3.0",
    "gsap": "3.15.1",
    "near-api-js": "5.1.1",
    "process": "0.11.10",
    "util": "0.12.5"
  },
  "overrides": {
    "decode-uri-component": "0.5.1",
    "nanoid": "5.1.16"
  }
}
